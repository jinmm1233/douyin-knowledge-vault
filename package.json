{
  "name": "douyin-knowledge-app",
  "version": "1.1.1",
  "description": "抖音收藏 → Obsidian 知识库桌面版：采集、转录、知识提取、笔记浏览、仓颉蒸馏，开箱即用（内置 Python / Whisper / 仓颉）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:feed": "node scripts/make-update-feed.mjs",
    "serve:feed": "node scripts/make-update-feed.mjs --serve"
  },
  "license": "MIT",
  "author": "eason",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.douyin.knowledge",
    "productName": "抖音知识库",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "cangjie-runner.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-runtime",
        "to": "dok-runtime",
        "filter": [
          "**/*",
          "!project/var/state.sqlite3",
          "!project/var/state.sqlite3-*",
          "!project/var/api-*.json",
          "!project/var/*.log",
          "!project/var/knowledge-cards/**",
          "!project/var/media/**",
          "!project/var/transcripts/**",
          "!project/var/knowledge/**",
          "!project/var/creator-knowledge/**",
          "!project/config.json",
          "!project/var/settings.json",
          "!project/var/backups/**",
          "!project/var/categories.json",
          "!project/var/sync-progress.json",
          "!project/var/api-usage.jsonl",
          "!project/var/*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jinmm1233",
        "repo": "douyin-knowledge-vault"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "抖音知识库",
      "uninstallDisplayName": "抖音知识库",
      "include": "build/uninstaller.nsh",
      "artifactName": "DouyinKnowledge-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
